# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Model routing: pick ONE level -------------------------------------------

# Level 0a: Anthropic directly
ANTHROPIC_API_KEY=

# Level 0b: Claude through an enterprise route (uncomment one, drop the key above)
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_RESOURCE=
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# Level 1: LiteLLM gateway — required for any non-Claude model.
#   docker compose up -d litellm
LITELLM_MASTER_KEY=sk-change-me
# ANTHROPIC_BASE_URL=http://host.docker.internal:4000/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-change-me
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- codex-container track ---------------------------------------------------
# Needs no gateway: Codex speaks OpenAI natively. Pick ONE credential.
#
# A dedicated variable on purpose — OPENAI_API_KEY above belongs to the gateway, and a
# gateway credential must never reach a runner.
CODEX_API_KEY=
# Or opt in to a ChatGPT login. The file is mounted read-only and copied into the
# session volume; code the agent runs can read that copy.
# CODEX_AUTH_FILE=~/.codex/auth.json
CODEX_MODEL=gpt-5.5
RUNNER_CODEX_IMAGE=agent-lab-runner-codex:latest
# Codex's own sandbox cannot start inside Docker (bubblewrap needs user namespaces), so
# the track runs danger-full-access and the container is the boundary. Override only on a
# host whose container runtime grants user namespaces.
# CODEX_SANDBOX_MODE=workspace-write

# --- Agent -------------------------------------------------------------------
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=40
AGENT_MAX_BUDGET_USD=5
# bypassPermissions | acceptEdits | default | plan
AGENT_PERMISSION_MODE=acceptEdits

# --- Runner containers -------------------------------------------------------
RUNNER_IMAGE=agent-lab-runner-claude:latest
RUNNER_MEMORY_MB=2048
RUNNER_CPUS=2
RUNNER_NETWORK=agent-lab-net
MAX_CONCURRENT_SESSIONS=4
# Host directory mounted read-only at /skills. Created by `bun run sync-skills`.
# Leave unset to auto-resolve: .skills-cache if it exists, otherwise the repo skills/ dir.
# SKILLS_HOST_PATH=./.skills-cache
# How a container reaches the orchestrator. On Windows the orchestrator runs on the
# host so it can talk to the Docker named pipe, hence host.docker.internal.
#
# THIS PORT MUST MATCH ORCHESTRATOR_PORT BELOW. Changing only one of them produces a
# container that starts, dials the wrong port and exits 0 with no useful error.
#
# It must also be a port no OTHER container publishes on 127.0.0.1. The orchestrator
# binds 0.0.0.0 and a published container port binds 127.0.0.1, so both can listen at
# once: the host reaches the orchestrator while host.docker.internal reaches the other
# container. The symptom is `websocket error: Unexpected server response: 200`.
# Check with: docker ps --format '{{.Names}}\t{{.Ports}}' | grep <port>
RUNNER_CALLBACK_WS=ws://host.docker.internal:8080

# --- Services ----------------------------------------------------------------
ORCHESTRATOR_PORT=8080
LITELLM_URL=http://127.0.0.1:4000
